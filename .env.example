# ---- Mode: api (http server, default) | worker (import queues), same image
#MODE=api

# ---- Server
PORT=4599
API_URL=https://french-props-api.example.com
DASH_URL=https://french-props-dash.example.com
WEB_URL=https://french-props.example.com

# ---- Auth
JWT_SALT=
# Session lifetime in seconds (default 1 day), renewed silently while in use
#JWT_TTL=86400
# Session cookie: parent domain shared by the api and the dash
COOKIE_DOMAIN=example.com
# Cookie name, change it when two instances share a parent domain (defaults to token)
COOKIE_NAME=fp_token
# Set to NO only for a plain http dev setup
#COOKIE_SECURE=YES
# WebAuthn relying party id, defaults to COOKIE_DOMAIN
#WEBAUTHN_RP_ID=example.com

# ---- Databases
MONGO=mongodb://user:pass@host:27017/french-props
REDIS=redis://host:6379

# ---- Storage: aws | local
STORAGE=aws
AWS_KEY=
AWS_SECRET=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
# S3 compatible provider (e.g. https://s3.fr-par.scw.cloud), AWS when empty
#AWS_ENDPOINT=
# Temporary files folder (uploads, resizes), defaults to ./temp
#STORAGE_TEMP=
# Thumbnails cache folder, defaults to <STORAGE_TEMP>/cache
#STORAGE_CACHE=
# Only with STORAGE=local
#STORAGE_ROOT=/data/storage

# ---- Mail (Mailjet)
# Mailjet template id wrapping every mail (title + content vars), plain mails when empty
MAIL_TEMPLATE=
MAIL_FROM=noreply@example.com
MAIL_REPLY=contact@example.com
# Sender display name when settings.brandName is empty
#MAIL_SENDER_NAME=FranceProps
SMTP_USER=
SMTP_PASS=
# Keep mails in the mail-queue (status held) instead of sending them
#MAIL_FAKE=1

# ---- Catalogue import (the worker processes it, the api drives it)
# A source without its accesses is not configured: it can't be started
# Product jobs processed in parallel per source, defaults to 4
#IMPORT_CONCURRENCY=4
# XXO: GraphQL endpoint (https://…/graphql_web), token of a "service" account (their dashboard, /token)
XXO_API_URL=
XXO_API_TOKEN=
# Defrise, Lanzani: GraphQL endpoint (https://…/graphql), long lived token of a dedicated user
DEFRISE_API_URL=
DEFRISE_API_TOKEN=
LANZANI_API_URL=
LANZANI_API_TOKEN=
